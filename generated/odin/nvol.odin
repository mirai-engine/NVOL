			mask6: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_lanes_eq(chunk2, v1), (U16x8)(4)) & 0x8888888888888888)
			if (mask6 != u64(0)) {
				return cur[uint(intrinsics.count_trailing_zeros(mask6) >> 2):]
			}
		}
		return nil
	}

	// Raw form of nvol_memchr over [start, end): pointer to the match, or NULL.
	nvol_memchr_raw :: proc "contextless" (n1: u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		if (uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start))) < uint(16)) {
			return nvol_memchr_scalar(n1, start, end)
		}
		return nvol_memchr_neon(n1, start, end)
	}

	// First index in hay[0..len) equal to any of 1 needle byte(s), or SIZE_MAX/usize::MAX if none.
	nvol_memchr :: proc "contextless" (n1: u8, start: [^]u8, len_: uint) -> uint #no_bounds_check {
		p: [^]u8 = nvol_memchr_raw(n1, start, start[len_:])
		if (p == nil) {
			return max(uint)
		}
		return uint(intrinsics.ptr_sub((^u8)(p), (^u8)(start)))
	}

	// word-at-a-time (SWAR) search; the dispatch's path under 16 bytes
	@(private)
	nvol_memrchr_scalar :: #force_inline proc "contextless" (n1: u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
