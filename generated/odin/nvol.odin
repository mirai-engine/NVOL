	// nvol_find_byteset: neon entry point
	@(private)
	nvol_find_byteset_entry_neon :: #force_no_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		count: uint = uint(intrinsics.unaligned_load((^u64)(cls[uint(48):])))
		if (count == uint(0)) {
			return nil
		}
		m: u8 = cls[uint(56):][uint(0):][0]
		m1: u8 = cls[uint(56):][uint(1):][0]
		m2: u8 = cls[uint(56):][uint(2):][0]
		if (count == uint(1)) {
			return nvol_memchr_raw(m, start, end)
		}
		if (count == uint(2)) {
			return nvol_memchr2_raw(m, m1, start, end)
		}
		if (count == uint(3)) {
			return nvol_memchr3_raw(m, m1, m2, start, end)
		}
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if (len_ < uint(16)) {
			return nvol_find_byteset_scalar(cls, start, end)
		}
		uniq: u8 = cls[uint(62):][0]
		range: u8 = cls[uint(80):][0]
		if (uniq != u8(0)) {
			return nvol_find_byteset_neon_u(cls, start, end)
		}
		if (count == uint(4)) {
			return nvol_find_byteset_neon_k4(cls, start, end)
		}
		if (count == uint(5)) {
			return nvol_find_byteset_neon_k5(cls, start, end)
		}
		if (count == uint(6)) {
			return nvol_find_byteset_neon_k6(cls, start, end)
		}
		if (range == u8(1)) {
			return nvol_find_byteset_neon_r0(cls, start, end)
		}
		if (range == u8(2)) {
			return nvol_find_byteset_neon_r1(cls, start, end)
		}
		if (range == u8(3)) {
			return nvol_find_byteset_neon_r2(cls, start, end)
		}
		if (range == u8(4)) {
			return nvol_find_byteset_neon_r3(cls, start, end)
		}
		return nvol_find_byteset_neon(cls, start, end)
	}

	// nvol_find_not_byteset: neon entry point
	@(private)
	nvol_find_not_byteset_entry_neon :: #force_no_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		count: uint = uint(intrinsics.unaligned_load((^u64)(cls[uint(48):])))
		if ((count == uint(0)) && (start < end)) {
			return start
		}
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if (len_ < uint(16)) {
			return nvol_find_not_byteset_scalar(cls, start, end)
		}
		uniq: u8 = cls[uint(62):][0]
		range: u8 = cls[uint(80):][0]
		if (uniq != u8(0)) {
			return nvol_find_not_byteset_neon_u(cls, start, end)
		}
		if (count == uint(1)) {
			return nvol_find_not_byteset_neon_k1(cls, start, end)
		}
		if (count == uint(2)) {
			return nvol_find_not_byteset_neon_k2(cls, start, end)
		}
		if (count == uint(3)) {
			return nvol_find_not_byteset_neon_k3(cls, start, end)
		}
		if (count == uint(4)) {
			return nvol_find_not_byteset_neon_k4(cls, start, end)
		}
		if (count == uint(5)) {
			return nvol_find_not_byteset_neon_k5(cls, start, end)
		}
		if (count == uint(6)) {
			return nvol_find_not_byteset_neon_k6(cls, start, end)
		}
		if (range == u8(1)) {
			return nvol_find_not_byteset_neon_r0(cls, start, end)
		}
		if (range == u8(2)) {
			return nvol_find_not_byteset_neon_r1(cls, start, end)
		}
		if (range == u8(3)) {
			return nvol_find_not_byteset_neon_r2(cls, start, end)
		}
		if (range == u8(4)) {
			return nvol_find_not_byteset_neon_r3(cls, start, end)
		}
		return nvol_find_not_byteset_neon(cls, start, end)
	}

	// nvol_find_byteset_pair: neon entry point
	@(private)
	nvol_find_byteset_pair_entry_neon :: #force_no_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		sel: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(240):])))
		reach: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(248):])))
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if ((sel == uint(0)) || (len_ <= reach)) {
			return nil
		}
		len_ = (len_ - reach)
		if (len_ < uint(16)) {
			return nvol_find_byteset_pair_scalar(st, start, end)
		}
		if (sel == uint(1)) {
			return nvol_find_byteset_pair_neon_k1(st, start, end)
		}
		if (sel == uint(2)) {
			return nvol_find_byteset_pair_neon_k2(st, start, end)
		}
		if (sel == uint(3)) {
			return nvol_find_byteset_pair_neon_k3(st, start, end)
		}
		if (sel == uint(4)) {
			return nvol_find_byteset_pair_neon_k4(st, start, end)
		}
		if (sel == uint(5)) {
			return nvol_find_byteset_pair_neon_k5(st, start, end)
		}
		if (sel == uint(6)) {
			return nvol_find_byteset_pair_neon_k6(st, start, end)
		}
		return nvol_find_byteset_pair_neon(st, start, end)
	}

	// nvol_find_byteset_pair_mask: neon entry point
	@(private)
	nvol_find_byteset_pair_mask_entry_neon :: #force_no_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, out: [^]u8) -> [^]u8 #no_bounds_check {
