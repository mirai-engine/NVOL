			if (range == u8(1)) {
				return nvol_find_byteset_sse2_r0(cls, start, end)
			}
			if (range == u8(2)) {
				return nvol_find_byteset_sse2_r1(cls, start, end)
			}
			if (range == u8(3)) {
				return nvol_find_byteset_sse2_r2(cls, start, end)
			}
			if (range == u8(4)) {
				return nvol_find_byteset_sse2_r3(cls, start, end)
			}
			return nvol_find_byteset_ssse3(cls, start, end)
		}
		if (uniq != u8(0)) {
			return nvol_find_byteset_avx2_u(cls, start, end)
		}
		if (count == uint(4)) {
			return nvol_find_byteset_avx2_k4(cls, start, end)
		}
		if (count == uint(5)) {
			return nvol_find_byteset_avx2_k5(cls, start, end)
		}
		if (count == uint(6)) {
			return nvol_find_byteset_avx2_k6(cls, start, end)
		}
		if (range == u8(1)) {
			return nvol_find_byteset_avx2_r0(cls, start, end)
		}
		if (range == u8(2)) {
			return nvol_find_byteset_avx2_r1(cls, start, end)
		}
		if (range == u8(3)) {
			return nvol_find_byteset_avx2_r2(cls, start, end)
		}
		if (range == u8(4)) {
			return nvol_find_byteset_avx2_r3(cls, start, end)
		}
		return nvol_find_byteset_avx2(cls, start, end)
