	// first p with hay[p+i1] in set 1 and hay[p+i2] in set 2 (nibble lookup); requires end - start >= max(i1, i2) + 16
	@(private, enable_target_feature="ssse3")
	nvol_find_byteset_pair_ssse3 :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		i1: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(224):])))
		i2: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(232):])))
		ta: V16 = intrinsics.unaligned_load((^V16)(st))
		tb: V16 = intrinsics.unaligned_load((^V16)(st[uint(16):]))
		bitpos: V16 = intrinsics.unaligned_load((^V16)(st[uint(32):]))
		ta1: V16 = intrinsics.unaligned_load((^V16)(st[uint(112):]))
		tb1: V16 = intrinsics.unaligned_load((^V16)(st[uint(112):][uint(16):]))
		bitpos1: V16 = intrinsics.unaligned_load((^V16)(st[uint(112):][uint(32):]))
		m8f: V16 = V16(u8(143))
		m80: V16 = V16(u8(128))
		max_: [^]u8 = ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int((max(i1, i2) + uint(16)))))
		cur: [^]u8 = start
		for (cur <= max_) {
			x: V16 = intrinsics.unaligned_load((^V16)(cur[i1:]))
			idx: V16 = intrinsics.simd_bit_and(x, m8f)
			bit: V16 = nvol_pshufb128(bitpos, intrinsics.simd_shr(x, V16(4)))
			e1: V16 = intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_pshufb128(ta, idx), nvol_pshufb128(tb, intrinsics.simd_sub(idx, m80))), bit), bit)
			x1: V16 = intrinsics.unaligned_load((^V16)(cur[i2:]))
			idx1: V16 = intrinsics.simd_bit_and(x1, m8f)
			bit1: V16 = nvol_pshufb128(bitpos1, intrinsics.simd_shr(x1, V16(4)))
			e2: V16 = intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_pshufb128(ta1, idx1), nvol_pshufb128(tb1, intrinsics.simd_sub(idx1, m80))), bit1), bit1)
			hit: u32 = transmute(u32)nvol_pmovmskb128(intrinsics.simd_bit_and(e1, e2))
			if (hit != u32(0)) {
				return cur[uint(intrinsics.count_trailing_zeros(hit)):]
			}
			cur = cur[uint(16):]
		}
		if (cur < max_[uint(16):]) {
			overlap: u32 = u32(uint(intrinsics.ptr_sub((^u8)(cur), (^u8)(max_))))
			tail_mask: u32 = (u32(4294967295) << overlap)
			x2: V16 = intrinsics.unaligned_load((^V16)(max_[i1:]))
			idx2: V16 = intrinsics.simd_bit_and(x2, m8f)
			bit2: V16 = nvol_pshufb128(bitpos, intrinsics.simd_shr(x2, V16(4)))
			e11: V16 = intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_pshufb128(ta, idx2), nvol_pshufb128(tb, intrinsics.simd_sub(idx2, m80))), bit2), bit2)
			x3: V16 = intrinsics.unaligned_load((^V16)(max_[i2:]))
			idx3: V16 = intrinsics.simd_bit_and(x3, m8f)
			bit3: V16 = nvol_pshufb128(bitpos1, intrinsics.simd_shr(x3, V16(4)))
			e21: V16 = intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_pshufb128(ta1, idx3), nvol_pshufb128(tb1, intrinsics.simd_sub(idx3, m80))), bit3), bit3)
			hit1: u32 = (transmute(u32)nvol_pmovmskb128(intrinsics.simd_bit_and(e11, e21)) & tail_mask)
			if (hit1 != u32(0)) {
				return max_[uint(intrinsics.count_trailing_zeros(hit1)):]
			}
		}
		return nil
	}

