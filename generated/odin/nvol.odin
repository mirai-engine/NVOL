	nvol_memrchr_raw :: #force_inline proc "contextless" (n1: u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_memrchr_raw_ptr(n1, start, end) }

	// Last index in hay[0..len) equal to any of 1 needle byte(s), or SIZE_MAX/usize::MAX if none.
	nvol_memrchr :: proc "contextless" (n1: u8, start: [^]u8, len_: uint) -> uint #no_bounds_check {
		p: [^]u8 = nvol_memrchr_raw(n1, start, start[len_:])
