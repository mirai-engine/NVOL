	// nvol_find_byteset_pair_visit: neon entry point
	@(private)
	nvol_find_byteset_pair_visit_entry_neon :: #force_no_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 #no_bounds_check {
