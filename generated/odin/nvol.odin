			if (sel == uint(3)) {
				return nvol_find_byteset_pair_mask_ssse3_k3(st, start, end, out)
			}
			if (sel == uint(4)) {
				return nvol_find_byteset_pair_mask_ssse3_k4(st, start, end, out)
			}
			if (sel == uint(5)) {
				return nvol_find_byteset_pair_mask_ssse3_k5(st, start, end, out)
			}
			if (sel == uint(6)) {
				return nvol_find_byteset_pair_mask_ssse3_k6(st, start, end, out)
			}
			return nvol_find_byteset_pair_mask_ssse3(st, start, end, out)
		}
		if (sel == uint(1)) {
			return nvol_find_byteset_pair_mask_avx2_k1(st, start, end, out)
		}
		if (sel == uint(2)) {
			return nvol_find_byteset_pair_mask_avx2_k2(st, start, end, out)
		}
		if (sel == uint(3)) {
			return nvol_find_byteset_pair_mask_avx2_k3(st, start, end, out)
		}
		if (sel == uint(4)) {
			return nvol_find_byteset_pair_mask_avx2_k4(st, start, end, out)
		}
		if (sel == uint(5)) {
			return nvol_find_byteset_pair_mask_avx2_k5(st, start, end, out)
		}
		if (sel == uint(6)) {
			return nvol_find_byteset_pair_mask_avx2_k6(st, start, end, out)
		}
		return nvol_find_byteset_pair_mask_avx2(st, start, end, out)
	}

	// nvol_find_byteset_pair_visit: avx2 entry point
	@(private, enable_target_feature="avx2,ssse3,pclmul,-slow-unaligned-mem-32")
	nvol_find_byteset_pair_visit_entry_avx2 :: #force_no_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 #no_bounds_check {
		sel: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(240):])))
		reach: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(248):])))
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if ((sel == uint(0)) || (len_ <= reach)) {
			return nil
		}
		len_ = (len_ - reach)
		if (len_ < uint(16)) {
			return nvol_find_byteset_pair_visit_scalar(st, start, end, visit)
		}
		if (len_ < uint(32)) {
			if (sel == uint(1)) {
				return nvol_find_byteset_pair_visit_ssse3_k1(st, start, end, visit)
			}
			if (sel == uint(2)) {
				return nvol_find_byteset_pair_visit_ssse3_k2(st, start, end, visit)
			}
			if (sel == uint(3)) {
				return nvol_find_byteset_pair_visit_ssse3_k3(st, start, end, visit)
			}
			if (sel == uint(4)) {
				return nvol_find_byteset_pair_visit_ssse3_k4(st, start, end, visit)
			}
			if (sel == uint(5)) {
				return nvol_find_byteset_pair_visit_ssse3_k5(st, start, end, visit)
			}
			if (sel == uint(6)) {
				return nvol_find_byteset_pair_visit_ssse3_k6(st, start, end, visit)
			}
			return nvol_find_byteset_pair_visit_ssse3(st, start, end, visit)
		}
		if (sel == uint(1)) {
			return nvol_find_byteset_pair_visit_avx2_k1(st, start, end, visit)
		}
		if (sel == uint(2)) {
			return nvol_find_byteset_pair_visit_avx2_k2(st, start, end, visit)
		}
		if (sel == uint(3)) {
			return nvol_find_byteset_pair_visit_avx2_k3(st, start, end, visit)
		}
		if (sel == uint(4)) {
			return nvol_find_byteset_pair_visit_avx2_k4(st, start, end, visit)
		}
		if (sel == uint(5)) {
			return nvol_find_byteset_pair_visit_avx2_k5(st, start, end, visit)
		}
		if (sel == uint(6)) {
			return nvol_find_byteset_pair_visit_avx2_k6(st, start, end, visit)
		}
		return nvol_find_byteset_pair_visit_avx2(st, start, end, visit)
	}

	// nvol_copy_until_byteset: avx2 entry point
	@(private, enable_target_feature="avx2,ssse3,pclmul,-slow-unaligned-mem-32")
	nvol_copy_until_byteset_entry_avx2 :: #force_no_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 #no_bounds_check {
		count: uint = uint(intrinsics.unaligned_load((^u64)(cls[uint(48):])))
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if (len_ < uint(16)) {
			return nvol_copy_until_byteset_scalar(cls, start, end, dst)
		}
		uniq: u8 = cls[uint(62):][0]
		range: u8 = cls[uint(80):][0]
		if (len_ < uint(32)) {
			if (uniq != u8(0)) {
				return nvol_copy_until_byteset_ssse3_u(cls, start, end, dst)
			}
			if (count == uint(1)) {
				return nvol_copy_until_byteset_sse2_k1(cls, start, end, dst)
			}
			if (count == uint(2)) {
				return nvol_copy_until_byteset_sse2_k2(cls, start, end, dst)
			}
			if (count == uint(3)) {
				return nvol_copy_until_byteset_sse2_k3(cls, start, end, dst)
			}
			if (count == uint(4)) {
				return nvol_copy_until_byteset_sse2_k4(cls, start, end, dst)
			}
			if (count == uint(5)) {
				return nvol_copy_until_byteset_sse2_k5(cls, start, end, dst)
			}
			if (count == uint(6)) {
				return nvol_copy_until_byteset_sse2_k6(cls, start, end, dst)
			}
			if (range == u8(1)) {
				return nvol_copy_until_byteset_sse2_r0(cls, start, end, dst)
			}
			if (range == u8(2)) {
				return nvol_copy_until_byteset_sse2_r1(cls, start, end, dst)
			}
			if (range == u8(3)) {
				return nvol_copy_until_byteset_sse2_r2(cls, start, end, dst)
			}
			if (range == u8(4)) {
				return nvol_copy_until_byteset_sse2_r3(cls, start, end, dst)
			}
			return nvol_copy_until_byteset_ssse3(cls, start, end, dst)
		}
		if (uniq != u8(0)) {
			return nvol_copy_until_byteset_avx2_u(cls, start, end, dst)
		}
		if (count == uint(1)) {
			return nvol_copy_until_byteset_avx2_k1(cls, start, end, dst)
		}
		if (count == uint(2)) {
			return nvol_copy_until_byteset_avx2_k2(cls, start, end, dst)
		}
		if (count == uint(3)) {
			return nvol_copy_until_byteset_avx2_k3(cls, start, end, dst)
		}
		if (count == uint(4)) {
			return nvol_copy_until_byteset_avx2_k4(cls, start, end, dst)
		}
		if (count == uint(5)) {
			return nvol_copy_until_byteset_avx2_k5(cls, start, end, dst)
		}
		if (count == uint(6)) {
			return nvol_copy_until_byteset_avx2_k6(cls, start, end, dst)
		}
		if (range == u8(1)) {
			return nvol_copy_until_byteset_avx2_r0(cls, start, end, dst)
		}
		if (range == u8(2)) {
			return nvol_copy_until_byteset_avx2_r1(cls, start, end, dst)
		}
		if (range == u8(3)) {
			return nvol_copy_until_byteset_avx2_r2(cls, start, end, dst)
		}
		if (range == u8(4)) {
			return nvol_copy_until_byteset_avx2_r3(cls, start, end, dst)
		}
		return nvol_copy_until_byteset_avx2(cls, start, end, dst)
	}

	// nvol_copy_until_byteset: base entry point
	@(private)
	nvol_copy_until_byteset_entry_base :: #force_no_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 #no_bounds_check {
		count: uint = uint(intrinsics.unaligned_load((^u64)(cls[uint(48):])))
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if (len_ < uint(16)) {
			return nvol_copy_until_byteset_scalar(cls, start, end, dst)
		}
		range: u8 = cls[uint(80):][0]
		if (count == uint(1)) {
			return nvol_copy_until_byteset_sse2_k1(cls, start, end, dst)
		}
		if (count == uint(2)) {
			return nvol_copy_until_byteset_sse2_k2(cls, start, end, dst)
		}
		if (count == uint(3)) {
			return nvol_copy_until_byteset_sse2_k3(cls, start, end, dst)
		}
		if (count == uint(4)) {
			return nvol_copy_until_byteset_sse2_k4(cls, start, end, dst)
		}
		if (count == uint(5)) {
			return nvol_copy_until_byteset_sse2_k5(cls, start, end, dst)
		}
		if (count == uint(6)) {
			return nvol_copy_until_byteset_sse2_k6(cls, start, end, dst)
		}
		if (range == u8(1)) {
			return nvol_copy_until_byteset_sse2_r0(cls, start, end, dst)
		}
		if (range == u8(2)) {
			return nvol_copy_until_byteset_sse2_r1(cls, start, end, dst)
		}
		if (range == u8(3)) {
			return nvol_copy_until_byteset_sse2_r2(cls, start, end, dst)
		}
		if (range == u8(4)) {
			return nvol_copy_until_byteset_sse2_r3(cls, start, end, dst)
		}
		return nvol_copy_until_byteset_scalar(cls, start, end, dst)
	}

	// Copy [start, end) to dst up to the first byte in the class built by nvol_byteset_init; returns that byte's address, or end. dst needs room for end - start bytes (whole vectors are stored, so bytes after the copied prefix may change); no overlap.
	@(private) nvol_copy_until_byteset_raw_ptr: proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 = nvol_copy_until_byteset_raw_resolve
	@(private) nvol_copy_until_byteset_raw_resolve :: proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 {
		f: proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 = nvol_copy_until_byteset_entry_base
		if nvol_cpu_avx2() { f = nvol_copy_until_byteset_entry_avx2 }
		nvol_copy_until_byteset_raw_ptr = f
		return f(cls, start, end, dst)
	}
	nvol_copy_until_byteset_raw :: #force_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 { return nvol_copy_until_byteset_raw_ptr(cls, start, end, dst) }

	// Every chunk with pair candidates, in order, to visit->fn(ctx, chunk, mask) (mask as in nvol_find_byteset_pair_mask_raw); returns the chunk where the visitor returned true, or NULL at the end. Inline the _visit kernels to fuse the visitor into their loop.
	@(private) nvol_find_byteset_pair_visit_raw_ptr: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 = nvol_find_byteset_pair_visit_raw_resolve
	@(private) nvol_find_byteset_pair_visit_raw_resolve :: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 {
		f: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 = nvol_find_byteset_pair_visit_scalar
		if nvol_cpu_avx2() { f = nvol_find_byteset_pair_visit_entry_avx2 }
		nvol_find_byteset_pair_visit_raw_ptr = f
		return f(st, start, end, visit)
	}
	nvol_find_byteset_pair_visit_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 { return nvol_find_byteset_pair_visit_raw_ptr(st, start, end, visit) }

	// First byte of [start, end) in the class built by nvol_byteset_init, or NULL.
	@(private) nvol_find_byteset_raw_ptr: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_find_byteset_raw_resolve
	@(private) nvol_find_byteset_raw_resolve :: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 {
		f: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_find_byteset_entry_base
		if nvol_cpu_avx2() { f = nvol_find_byteset_entry_avx2 }
		nvol_find_byteset_raw_ptr = f
		return f(st, start, end)
	}
	nvol_find_byteset_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_find_byteset_raw_ptr(st, start, end) }

	// First byte of [start, end) outside the class built by nvol_byteset_init, or NULL.
	@(private) nvol_find_not_byteset_raw_ptr: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_find_not_byteset_raw_resolve
	@(private) nvol_find_not_byteset_raw_resolve :: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 {
		f: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_find_not_byteset_entry_base
		if nvol_cpu_sse42() { f = nvol_find_not_byteset_entry_sse42 }
		if nvol_cpu_avx2() { f = nvol_find_not_byteset_entry_avx2 }
		nvol_find_not_byteset_raw_ptr = f
		return f(st, start, end)
	}
	nvol_find_not_byteset_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_find_not_byteset_raw_ptr(st, start, end) }

	// First p in [start, end) with p[i1] in set 1 and p[i2] in set 2 (state from nvol_byteset_pair_init), or NULL.
	@(private) nvol_find_byteset_pair_raw_ptr: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_find_byteset_pair_raw_resolve
	@(private) nvol_find_byteset_pair_raw_resolve :: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 {
		f: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_find_byteset_pair_scalar
		if nvol_cpu_avx2() { f = nvol_find_byteset_pair_entry_avx2 }
		nvol_find_byteset_pair_raw_ptr = f
		return f(st, start, end)
	}
	nvol_find_byteset_pair_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_find_byteset_pair_raw_ptr(st, start, end) }

	// Like nvol_find_byteset_pair_raw, but returns the base of the first chunk with candidates and stores all its candidates to *out: position base + i is a candidate when bit i (x86_64) or bit 4i+3 (aarch64) is set. NULL when there is none.
	@(private) nvol_find_byteset_pair_mask_raw_ptr: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, out: [^]u8) -> [^]u8 = nvol_find_byteset_pair_mask_raw_resolve
	@(private) nvol_find_byteset_pair_mask_raw_resolve :: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, out: [^]u8) -> [^]u8 {
		f: proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, out: [^]u8) -> [^]u8 = nvol_find_byteset_pair_mask_scalar
		if nvol_cpu_avx2() { f = nvol_find_byteset_pair_mask_entry_avx2 }
		nvol_find_byteset_pair_mask_raw_ptr = f
		return f(st, start, end, out)
	}
	nvol_find_byteset_pair_mask_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, out: [^]u8) -> [^]u8 { return nvol_find_byteset_pair_mask_raw_ptr(st, start, end, out) }

	// stage 1, scalar masks
	@(private)
	nvol_json_index_scalar :: #force_inline proc "contextless" (state: [^]u8, blocks: [^]u8, nblocks: uint, idx: uint, out: [^]u8) -> uint #no_bounds_check {
		nie: u64 = intrinsics.unaligned_load((^u64)(state))
		pis: u64 = intrinsics.unaligned_load((^u64)(state[uint(8):]))
		psc: u64 = intrinsics.unaligned_load((^u64)(state[uint(16):]))
		err: u64 = intrinsics.unaligned_load((^u64)(state[uint(24):]))
		blk: [^]u8 = blocks
		base: uint = idx
		end: [^]u8 = blocks[(nblocks << uint(6)):]
		n: uint = uint(0)
		prev: u64 = u64(0)
		pbase: uint = idx
		end2: [^]u8 = blocks[((nblocks >> uint(1)) << uint(7)):]
		for (blk < end2) {
			bs: u64 = u64(0)
			qt: u64 = u64(0)
			ws: u64 = u64(0)
			op: u64 = u64(0)
			ctl: u64 = u64(0)
			i: uint = uint(0)
			for (i < uint(64)) {
				c: u8 = blk[i:][0]
				bit: u64 = (u64(1) << u64(i))
				if (c == u8(92)) {
					bs = (bs | bit)
				}
				if (c == u8(34)) {
					qt = (qt | bit)
				}
				if (((c == u8(32)) || (c == u8(9))) || ((c == u8(10)) || (c == u8(13)))) {
					ws = (ws | bit)
				}
				c20: u8 = (c | u8(32))
				if (((c20 == u8(58)) || (c20 == u8(123))) || ((c20 == u8(44)) || (c20 == u8(125)))) {
					op = (op | bit)
				}
				if (c <= u8(31)) {
					ctl = (ctl | bit)
				}
				i = (i + uint(1))
			}
			pe: u64 = (bs & (nie ~ u64(18446744073709551615)))
			code: u64 = ((((pe << u64(1)) | u64(12297829382473034410)) - pe) ~ u64(12297829382473034410))
			escaped: u64 = (code ~ (bs | nie))
			nie = ((code & bs) >> u64(63))
			quote: u64 = (qt & (escaped ~ u64(18446744073709551615)))
			px: u64 = quote
			px = (px ~ (px << u64(1)))
			px = (px ~ (px << u64(2)))
			px = (px ~ (px << u64(4)))
			px = (px ~ (px << u64(8)))
			px = (px ~ (px << u64(16)))
			px = (px ~ (px << u64(32)))
			in_string: u64 = (px ~ pis)
			pis = (u64(0) - (in_string >> u64(63)))
			scalar: u64 = ((op | ws) ~ u64(18446744073709551615))
			nqs: u64 = (scalar & (quote ~ u64(18446744073709551615)))
			follows: u64 = ((nqs << u64(1)) | psc)
			psc = (nqs >> u64(63))
			bits: u64 = ((op | (scalar & (follows ~ u64(18446744073709551615)))) & ((in_string ~ quote) ~ u64(18446744073709551615)))
			err = (err | (ctl & in_string))
			bits1: u64 = bits
			bs1: u64 = u64(0)
			qt1: u64 = u64(0)
			ws1: u64 = u64(0)
			op1: u64 = u64(0)
			ctl1: u64 = u64(0)
			i1: uint = uint(0)
			for (i1 < uint(64)) {
				c1: u8 = blk[uint(64):][i1:][0]
				bit1: u64 = (u64(1) << u64(i1))
				if (c1 == u8(92)) {
					bs1 = (bs1 | bit1)
				}
				if (c1 == u8(34)) {
					qt1 = (qt1 | bit1)
				}
				if (((c1 == u8(32)) || (c1 == u8(9))) || ((c1 == u8(10)) || (c1 == u8(13)))) {
					ws1 = (ws1 | bit1)
				}
				c201: u8 = (c1 | u8(32))
				if (((c201 == u8(58)) || (c201 == u8(123))) || ((c201 == u8(44)) || (c201 == u8(125)))) {
					op1 = (op1 | bit1)
				}
				if (c1 <= u8(31)) {
					ctl1 = (ctl1 | bit1)
				}
				i1 = (i1 + uint(1))
			}
			pe1: u64 = (bs1 & (nie ~ u64(18446744073709551615)))
			code1: u64 = ((((pe1 << u64(1)) | u64(12297829382473034410)) - pe1) ~ u64(12297829382473034410))
			escaped1: u64 = (code1 ~ (bs1 | nie))
			nie = ((code1 & bs1) >> u64(63))
			quote1: u64 = (qt1 & (escaped1 ~ u64(18446744073709551615)))
			px1: u64 = quote1
			px1 = (px1 ~ (px1 << u64(1)))
			px1 = (px1 ~ (px1 << u64(2)))
			px1 = (px1 ~ (px1 << u64(4)))
			px1 = (px1 ~ (px1 << u64(8)))
			px1 = (px1 ~ (px1 << u64(16)))
			px1 = (px1 ~ (px1 << u64(32)))
			in_string1: u64 = (px1 ~ pis)
			pis = (u64(0) - (in_string1 >> u64(63)))
			scalar1: u64 = ((op1 | ws1) ~ u64(18446744073709551615))
			nqs1: u64 = (scalar1 & (quote1 ~ u64(18446744073709551615)))
			follows1: u64 = ((nqs1 << u64(1)) | psc)
			psc = (nqs1 >> u64(63))
			bits2: u64 = ((op1 | (scalar1 & (follows1 ~ u64(18446744073709551615)))) & ((in_string1 ~ quote1) ~ u64(18446744073709551615)))
			err = (err | (ctl1 & in_string1))
			if (prev != u64(0)) {
