	// first byte of [start, end) in the class; requires end - start >= 16
	@(private, enable_target_feature="ssse3")
	nvol_find_byteset_ssse3 :: #force_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		ta: V16 = intrinsics.unaligned_load((^V16)(cls))
		tb: V16 = intrinsics.unaligned_load((^V16)(cls[uint(16):]))
		bitpos: V16 = intrinsics.unaligned_load((^V16)(cls[uint(32):]))
		m8f: V16 = V16(u8(143))
		m80: V16 = V16(u8(128))
		cur: [^]u8 = start
		for (cur <= ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(16))))) {
			x: V16 = intrinsics.unaligned_load((^V16)(cur))
			idx: V16 = intrinsics.simd_bit_and(x, m8f)
			bit: V16 = nvol_pshufb128(bitpos, intrinsics.simd_shr(x, V16(4)))
			hit: u32 = transmute(u32)nvol_pmovmskb128(intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_pshufb128(ta, idx), nvol_pshufb128(tb, intrinsics.simd_sub(idx, m80))), bit), bit))
			if (hit != u32(0)) {
				return cur[uint(intrinsics.count_trailing_zeros(hit)):]
			}
			cur = cur[uint(16):]
		}
		if (cur < end) {
			last: [^]u8 = ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(16))))
			overlap: u32 = u32(uint(intrinsics.ptr_sub((^u8)(cur), (^u8)(last))))
			tail_mask: u32 = (u32(4294967295) << overlap)
			x1: V16 = intrinsics.unaligned_load((^V16)(last))
			idx1: V16 = intrinsics.simd_bit_and(x1, m8f)
			bit1: V16 = nvol_pshufb128(bitpos, intrinsics.simd_shr(x1, V16(4)))
			hit1: u32 = (transmute(u32)nvol_pmovmskb128(intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_pshufb128(ta, idx1), nvol_pshufb128(tb, intrinsics.simd_sub(idx1, m80))), bit1), bit1)) & tail_mask)
			if (hit1 != u32(0)) {
				return last[uint(intrinsics.count_trailing_zeros(hit1)):]
			}
		}
		return nil
	}

