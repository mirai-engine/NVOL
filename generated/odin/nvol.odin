	// first byte of [start, end) outside the class, by pcmpistri; needs the class's member list (1-16 members, no 0) and end - start >= 16
	@(private, enable_target_feature="sse4.2,ssse3")
	nvol_find_not_byteset_sse42 :: #force_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		set: V16 = intrinsics.unaligned_load((^V16)(cls[uint(96):]))
		cur: [^]u8 = start
		last: [^]u8 = ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(16))))
		for (cur <= last) {
			i: u32 = u32(nvol_pcmpistri128(set, intrinsics.unaligned_load((^V16)(cur)), 0x10))
			if (i < u32(16)) {
				return cur[uint(i):]
			}
			cur = cur[uint(16):]
		}
		if (cur < end) {
			i_tail: u32 = u32(nvol_pcmpistri128(set, intrinsics.unaligned_load((^V16)(last)), 0x10))
			if (i_tail < u32(16)) {
				return last[uint(i_tail):]
			}
		}
		return nil
	}

	// nvol_find_byteset: avx2 entry point
	@(private, enable_target_feature="avx2,ssse3,pclmul,-slow-unaligned-mem-32")
	nvol_find_byteset_entry_avx2 :: #force_no_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		count: uint = uint(intrinsics.unaligned_load((^u64)(cls[uint(48):])))
