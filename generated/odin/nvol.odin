			m1: u32 = ((((w1 ~ sh1) - u32(16843009)) & ((w1 ~ sh1) ~ u32(4294967295))) & u32(2155905152))
			if (m1 != u32(0)) {
				return ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(4))))[(uint(intrinsics.count_trailing_zeros(m1)) >> uint(3)):]
			}
			return nil
		}
