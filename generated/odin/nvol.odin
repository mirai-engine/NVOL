			e1: V32 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i1:])), a), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i1:])), a1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i1:])), a2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i1:])), a3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i1:])), a4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i1:])), a5))
			e2: V32 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i2:])), b), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i2:])), b1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i2:])), b2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i2:])), b3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i2:])), b4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(cur[i2:])), b5))
			hit: u32 = transmute(u32)nvol_pmovmskb256(intrinsics.simd_bit_and(e1, e2))
			if (hit != u32(0)) {
				if visit.visit(visit.ctx, cur, u64(hit)) {
