			hit1: u64 = ((transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_bit_and(e11, e21), (U16x8)(4)) & 0x8888888888888888) & tail_mask)
			if (hit1 != u64(0)) {
