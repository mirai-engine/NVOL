				fill1 = out[uint(112):][uint(82):][0]
			}
			for (extra1 < uint(3)) {
				out[uint(112):][uint(82):][extra1:][0] = u8(fill1)
				extra1 = (extra1 + uint(1))
			}
		}
		intrinsics.unaligned_store((^u64)(out[uint(224):]), u64(i1))
		intrinsics.unaligned_store((^u64)(out[uint(232):]), u64(i2))
		c11: uint = uint(intrinsics.unaligned_load((^u64)(out[uint(48):])))
		c2: uint = uint(intrinsics.unaligned_load((^u64)(out[uint(112):][uint(48):])))
		sel: uint = max(c11, c2)
		if (sel > uint(6)) {
			sel = uint(7)
		}
		if (c11 == uint(0)) {
			sel = uint(0)
		}
		if (c2 == uint(0)) {
			sel = uint(0)
		}
		intrinsics.unaligned_store((^u64)(out[uint(240):]), u64(sel))
		intrinsics.unaligned_store((^u64)(out[uint(248):]), u64(max(i1, i2)))
	}

	// byte-at-a-time fallback
	@(private)
	nvol_find_byteset_scalar :: #force_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		p: [^]u8 = start
		for (p < end) {
