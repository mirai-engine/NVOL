	// Leftmost-first match in [hstart, hend): (start - hstart) << 8 | pattern id, or SIZE_MAX. state from nvol_teddy_init (kind != 0), blob = patterns.
	nvol_teddy_find_raw :: proc "contextless" (state: [^]u8, blob: [^]u8, hstart: [^]u8, hend: [^]u8) -> uint #no_bounds_check {
		if (uint(intrinsics.unaligned_load((^u64)(state))) == uint(0)) {
			return max(uint)
		}
		hlen: uint = uint(intrinsics.ptr_sub((^u8)(hend), (^u8)(hstart)))
		if (hlen < uint(intrinsics.unaligned_load((^u64)(state[uint(24):])))) {
			return nvol_teddy_slow(state, blob, hstart, hend)
		}
		sel: uint = uint(intrinsics.unaligned_load((^u64)(state[uint(40):])))
		if (hlen < uint(intrinsics.unaligned_load((^u64)(state[uint(56):])))) {
			sel = uint(intrinsics.unaligned_load((^u64)(state[uint(48):])))
		}
		return NVOL_FNTBL_TEDDY[sel](state, blob, hstart, hend)
	}

	// Build a byte-set class from set[0..n) (duplicates allowed) into out[112]
	nvol_byteset_init :: proc "contextless" (set: [^]u8, n: uint, out: [^]u8) #no_bounds_check {
		z: uint = uint(0)
		for (z < uint(112)) {
			intrinsics.unaligned_store((^u64)(out[z:]), u64(0))
			z = (z + uint(8))
		}
		k: uint = uint(0)
		for (k < uint(16)) {
			out[uint(32):][k:][0] = u8((u8(1) << u8((k & uint(7)))))
			k = (k + uint(1))
		}
		for (k > uint(0)) {
			k = (k - uint(1))
			out[uint(64):][k:][0] = u8(u8(((k + uint(1)) & uint(15))))
		}
		used: uint = uint(0)
		uniq: uint = uint(1)
		distinct_: uint = uint(0)
		i: uint = uint(0)
		for (i < n) {
			byte: u8 = set[i:][0]
			lo: uint = uint((byte & u8(15)))
			hi: u8 = (byte >> u8(4))
			row: [^]u8 = out[uint(0):][lo:]
			if (hi >= u8(8)) {
				row = out[uint(16):][lo:]
			}
			bit: u8 = (u8(1) << (hi & u8(7)))
			old: u8 = row[0]
			if ((old & bit) == u8(0)) {
				if (distinct_ < uint(6)) {
					out[uint(56):][distinct_:][0] = u8(byte)
				}
				distinct_ = (distinct_ + uint(1))
				lobit: uint = (uint(1) << lo)
				if ((used & lobit) != uint(0)) {
					uniq = uint(0)
				}
				used = (used | lobit)
				out[uint(64):][lo:][0] = u8(byte)
			}
			row[0] = u8((old | bit))
			i = (i + uint(1))
		}
		intrinsics.unaligned_store((^u64)(out[uint(48):]), u64(distinct_))
		if ((uniq != uint(0)) && (distinct_ != uint(0))) {
			out[uint(62):][0] = u8(u8(1))
		}
		first: u8 = out[uint(56):][0]
		pad: uint = distinct_
		for ((pad != uint(0)) && (pad < uint(6))) {
			out[uint(56):][pad:][0] = u8(first)
			pad = (pad + uint(1))
		}
		t: uint = uint(0)
		for ((t < uint(256)) && ((out[(uint((u8(t) >> u8(7))) << uint(4)):][uint((u8(t) & u8(15))):][0] & (u8(1) << ((u8(t) >> u8(4)) & u8(7)))) != u8(0))) {
			t = (t + uint(1))
		}
		extra: uint = uint(0)
		c: uint = t
		for (c < uint(256)) {
			if ((out[(uint((u8(c) >> u8(7))) << uint(4)):][uint((u8(c) & u8(15))):][0] & (u8(1) << ((u8(c) >> u8(4)) & u8(7)))) != u8(0)) {
				if (extra < uint(3)) {
					out[uint(82):][extra:][0] = u8(u8(c))
				}
				extra = (extra + uint(1))
			}
			c = (c + uint(1))
		}
		if (((distinct_ != uint(0)) && (distinct_ <= uint(16))) && (t == uint(0))) {
			j: uint = uint(0)
			m: uint = uint(1)
			for (m < uint(256)) {
				if ((out[(uint((u8(m) >> u8(7))) << uint(4)):][uint((u8(m) & u8(15))):][0] & (u8(1) << ((u8(m) >> u8(4)) & u8(7)))) != u8(0)) {
					out[uint(96):][j:][0] = u8(u8(m))
					j = (j + uint(1))
				}
				m = (m + uint(1))
			}
			out[uint(85):][0] = u8(u8(1))
		}
		if (((t >= uint(2)) && (extra <= uint(3))) && ((distinct_ > uint(6)) && (uniq == uint(0)))) {
			top: u8 = u8((t - uint(1)))
			out[uint(80):][0] = u8(u8((extra + uint(1))))
			out[uint(81):][0] = u8(top)
			fill: u8 = top
			if (extra != uint(0)) {
				fill = out[uint(82):][0]
			}
			for (extra < uint(3)) {
				out[uint(82):][extra:][0] = u8(fill)
				extra = (extra + uint(1))
			}
		}
	}

	// Pair state: set1 at offset i1, set2 at offset i2, into out[256]
	nvol_byteset_pair_init :: proc "contextless" (set1: [^]u8, n1: uint, set2: [^]u8, n2: uint, i1: uint, i2: uint, out: [^]u8) #no_bounds_check {
