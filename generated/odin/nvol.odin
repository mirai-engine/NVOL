			}
			cur = cur[uint(16):]
		}
		if (cur < end) {
			cur = ([^]u8)(intrinsics.ptr_offset((^u8)(cur), -int((uint(16) - uint(intrinsics.ptr_sub((^u8)(end), (^u8)(cur)))))))
