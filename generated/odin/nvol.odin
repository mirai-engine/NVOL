		w2: u64 = intrinsics.unaligned_load((^u64)(start))
		m2: u64 = ((((w2 ~ sw1) - u64(72340172838076673)) & ((w2 ~ sw1) ~ u64(18446744073709551615))) & u64(9259542123273814144))
		if (m2 != u64(0)) {
			return start[(uint(intrinsics.count_trailing_zeros(m2)) >> uint(3)):]
		}
		if (len_ <= uint(16)) {
			w3: u64 = intrinsics.unaligned_load((^u64)(([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(8))))))
			m3: u64 = ((((w3 ~ sw1) - u64(72340172838076673)) & ((w3 ~ sw1) ~ u64(18446744073709551615))) & u64(9259542123273814144))
			if (m3 != u64(0)) {
				return ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(8))))[(uint(intrinsics.count_trailing_zeros(m3)) >> uint(3)):]
			}
			return nil
		}
		q: [^]u8 = ([^]u8)(uintptr((uint(uintptr(start)) | uint(7)) + uint(1)))
		for (q <= ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(8))))) {
			w4: u64 = intrinsics.unaligned_load((^u64)(q))
			m4: u64 = ((((w4 ~ sw1) - u64(72340172838076673)) & ((w4 ~ sw1) ~ u64(18446744073709551615))) & u64(9259542123273814144))
			if (m4 != u64(0)) {
				return q[(uint(intrinsics.count_trailing_zeros(m4)) >> uint(3)):]
			}
			q = q[uint(8):]
		}
		if (q < end) {
			w5: u64 = intrinsics.unaligned_load((^u64)(([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(8))))))
			m5: u64 = ((((w5 ~ sw1) - u64(72340172838076673)) & ((w5 ~ sw1) ~ u64(18446744073709551615))) & u64(9259542123273814144))
			if (m5 != u64(0)) {
				return ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(8))))[(uint(intrinsics.count_trailing_zeros(m5)) >> uint(3)):]
			}
		}
		return nil
	}

	// pointer to the first byte in [start, end) equal to any of 1 needle(s), or NULL; requires end - start >= 16
	@(private)
	nvol_memchr_neon :: #force_inline proc "contextless" (n1: u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		v1: V16 = V16(n1)
		chunk: V16 = intrinsics.unaligned_load((^V16)(start))
		mask: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_lanes_eq(chunk, v1), (U16x8)(4)) & 0x8888888888888888)
		if (mask != u64(0)) {
			return start[uint(intrinsics.count_trailing_zeros(mask) >> 2):]
		}
		cur: [^]u8 = ([^]u8)(uintptr((uint(uintptr(start)) | uint(15)) + uint(1)))
		if (len_ >= uint(64)) {
			for (cur <= ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(64))))) {
				ld: V16 = (^V16)(cur)^
				ld1: V16 = (^V16)(cur[uint(16):])^
				ld2: V16 = (^V16)(cur[uint(32):])^
				ld3: V16 = (^V16)(cur[uint(48):])^
				eq: V16 = intrinsics.simd_lanes_eq(ld, v1)
				eq1: V16 = intrinsics.simd_lanes_eq(ld1, v1)
				eq2: V16 = intrinsics.simd_lanes_eq(ld2, v1)
				eq3: V16 = intrinsics.simd_lanes_eq(ld3, v1)
				any: V16 = intrinsics.simd_max(intrinsics.simd_max(eq, eq1), intrinsics.simd_max(eq2, eq3))
				if (intrinsics.simd_reduce_or(any) != 0) {
					mask1: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)eq, (U16x8)(4)) & 0x8888888888888888)
					if (mask1 != u64(0)) {
						return cur[uint(intrinsics.count_trailing_zeros(mask1) >> 2):]
					}
					mask2: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)eq1, (U16x8)(4)) & 0x8888888888888888)
					if (mask2 != u64(0)) {
						return cur[uint(16):][uint(intrinsics.count_trailing_zeros(mask2) >> 2):]
					}
					mask3: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)eq2, (U16x8)(4)) & 0x8888888888888888)
					if (mask3 != u64(0)) {
						return cur[uint(32):][uint(intrinsics.count_trailing_zeros(mask3) >> 2):]
					}
					mask4: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)eq3, (U16x8)(4)) & 0x8888888888888888)
					return cur[uint(48):][uint(intrinsics.count_trailing_zeros(mask4) >> 2):]
				}
				cur = cur[uint(64):]
			}
		}
		for (cur <= ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(16))))) {
			chunk1: V16 = intrinsics.unaligned_load((^V16)(cur))
			mask5: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_lanes_eq(chunk1, v1), (U16x8)(4)) & 0x8888888888888888)
			if (mask5 != u64(0)) {
