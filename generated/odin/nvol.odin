		op_table: V16 = V16{u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(58), u8(123), u8(44), u8(125), u8(0), u8(0)}
		k_bs: V16 = V16(u8(92))
		k_qt: V16 = V16(u8(34))
		k20: V16 = V16(u8(32))
