	// Raw form of nvol_memrchr over [start, end): pointer to the match, or NULL.
	@(private) nvol_memrchr_raw_ptr: proc "contextless" (n1: u8, start: [^]u8, end: [^]u8) -> [^]u8 = nvol_memrchr_raw_resolve
	@(private) nvol_memrchr_raw_resolve :: proc "contextless" (n1: u8, start: [^]u8, end: [^]u8) -> [^]u8 {
