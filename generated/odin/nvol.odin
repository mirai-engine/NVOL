				}
			}
			p = p[uint(1):]
		}
		return nil
	}

	// position-at-a-time fallback
	@(private)
	nvol_find_byteset_pair_visit_scalar :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 #no_bounds_check {
		i1: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(224):])))
		i2: uint = uint(intrinsics.unaligned_load((^u64)(st[uint(232):])))
		span: uint = (max(i1, i2) + uint(1))
		if (uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start))) < span) {
			return nil
		}
		last: [^]u8 = ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(span)))
		p: [^]u8 = start
		for (p <= last) {
			if ((st[(uint((p[i1:][0] >> u8(7))) << uint(4)):][uint((p[i1:][0] & u8(15))):][0] & (u8(1) << ((p[i1:][0] >> u8(4)) & u8(7)))) != u8(0)) {
				if ((st[uint(112):][(uint((p[i2:][0] >> u8(7))) << uint(4)):][uint((p[i2:][0] & u8(15))):][0] & (u8(1) << ((p[i2:][0] >> u8(4)) & u8(7)))) != u8(0)) {
					if visit.visit(visit.ctx, p, u64(8)) {
						return p
					}
				}
			}
			p = p[uint(1):]
		}
		return nil
	}

	// first byte of [start, end) in the class; requires end - start >= 16
	@(private)
	nvol_find_byteset_neon :: #force_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 #no_bounds_check {
		ta: V16 = intrinsics.unaligned_load((^V16)(cls))
		tb: V16 = intrinsics.unaligned_load((^V16)(cls[uint(16):]))
		bitpos: V16 = intrinsics.unaligned_load((^V16)(cls[uint(32):]))
		m8f: V16 = V16(u8(143))
		m80: V16 = V16(u8(128))
		cur: [^]u8 = start
		for (cur <= ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(16))))) {
			x: V16 = intrinsics.unaligned_load((^V16)(cur))
			idx: V16 = intrinsics.simd_bit_and(x, m8f)
			bit: V16 = nvol_tbl1(bitpos, intrinsics.simd_shr(x, V16(4)))
			hit: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_tbl1(ta, idx), nvol_tbl1(tb, intrinsics.simd_sub(idx, m80))), bit), bit), (U16x8)(4)) & 0x8888888888888888)
			if (hit != u64(0)) {
				return cur[uint(intrinsics.count_trailing_zeros(hit) >> 2):]
			}
			cur = cur[uint(16):]
		}
		if (cur < end) {
			last: [^]u8 = ([^]u8)(intrinsics.ptr_offset((^u8)(end), -int(uint(16))))
			overlap: u64 = u64((uint(intrinsics.ptr_sub((^u8)(cur), (^u8)(last))) << uint(2)))
			tail_mask: u64 = (u64(18446744073709551615) << overlap)
			x1: V16 = intrinsics.unaligned_load((^V16)(last))
			idx1: V16 = intrinsics.simd_bit_and(x1, m8f)
			bit1: V16 = nvol_tbl1(bitpos, intrinsics.simd_shr(x1, V16(4)))
			hit1: u64 = ((transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_lanes_eq(intrinsics.simd_bit_and(intrinsics.simd_bit_or(nvol_tbl1(ta, idx1), nvol_tbl1(tb, intrinsics.simd_sub(idx1, m80))), bit1), bit1), (U16x8)(4)) & 0x8888888888888888) & tail_mask)
			if (hit1 != u64(0)) {
				return last[uint(intrinsics.count_trailing_zeros(hit1) >> 2):]
			}
		}
