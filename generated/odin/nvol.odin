			tail_mask: u32 = (u32(4294967295) << overlap)
			e11: V32 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i1:])), a), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i1:])), a1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i1:])), a2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i1:])), a3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i1:])), a4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i1:])), a5))
			e21: V32 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i2:])), b), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i2:])), b1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i2:])), b2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i2:])), b3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i2:])), b4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V32)(max_[i2:])), b5))
