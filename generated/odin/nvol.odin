		}
		if (count == uint(3)) {
			return nvol_copy_until_byteset_neon_k3(cls, start, end, dst)
		}
		if (count == uint(4)) {
			return nvol_copy_until_byteset_neon_k4(cls, start, end, dst)
		}
		if (count == uint(5)) {
