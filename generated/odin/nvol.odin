			prev = (prev & (prev - u64(1)))
			if (cnt3 > uint(4)) {
				intrinsics.unaligned_store((^u32)(o3[uint(16):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
				prev = (prev & (prev - u64(1)))
				intrinsics.unaligned_store((^u32)(o3[uint(20):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
				prev = (prev & (prev - u64(1)))
				intrinsics.unaligned_store((^u32)(o3[uint(24):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
				prev = (prev & (prev - u64(1)))
				intrinsics.unaligned_store((^u32)(o3[uint(28):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
				prev = (prev & (prev - u64(1)))
				if (cnt3 > uint(8)) {
					intrinsics.unaligned_store((^u32)(o3[uint(32):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
					prev = (prev & (prev - u64(1)))
					intrinsics.unaligned_store((^u32)(o3[uint(36):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
					prev = (prev & (prev - u64(1)))
					intrinsics.unaligned_store((^u32)(o3[uint(40):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
					prev = (prev & (prev - u64(1)))
					intrinsics.unaligned_store((^u32)(o3[uint(44):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
					prev = (prev & (prev - u64(1)))
					if (cnt3 > uint(12)) {
						intrinsics.unaligned_store((^u32)(o3[uint(48):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
						prev = (prev & (prev - u64(1)))
						intrinsics.unaligned_store((^u32)(o3[uint(52):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
						prev = (prev & (prev - u64(1)))
						intrinsics.unaligned_store((^u32)(o3[uint(56):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
						prev = (prev & (prev - u64(1)))
						intrinsics.unaligned_store((^u32)(o3[uint(60):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
						prev = (prev & (prev - u64(1)))
						if (cnt3 > uint(16)) {
							intrinsics.unaligned_store((^u32)(o3[uint(64):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
							prev = (prev & (prev - u64(1)))
							intrinsics.unaligned_store((^u32)(o3[uint(68):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
							prev = (prev & (prev - u64(1)))
							intrinsics.unaligned_store((^u32)(o3[uint(72):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
							prev = (prev & (prev - u64(1)))
							intrinsics.unaligned_store((^u32)(o3[uint(76):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
							prev = (prev & (prev - u64(1)))
							if (cnt3 > uint(20)) {
								intrinsics.unaligned_store((^u32)(o3[uint(80):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
								prev = (prev & (prev - u64(1)))
								intrinsics.unaligned_store((^u32)(o3[uint(84):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
								prev = (prev & (prev - u64(1)))
								intrinsics.unaligned_store((^u32)(o3[uint(88):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
								prev = (prev & (prev - u64(1)))
								intrinsics.unaligned_store((^u32)(o3[uint(92):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
								prev = (prev & (prev - u64(1)))
								if (cnt3 > uint(24)) {
									i3: uint = uint(24)
									for (i3 < cnt3) {
										intrinsics.unaligned_store((^u32)(o3[(i3 << uint(2)):]), u32((pbase + uint(intrinsics.count_trailing_zeros(prev)))))
										prev = (prev & (prev - u64(1)))
										i3 = (i3 + uint(1))
									}
								}
							}
						}
					}
				}
			}
			n = (n + cnt3)
		}
		intrinsics.unaligned_store((^u64)(state), nie)
		intrinsics.unaligned_store((^u64)(state[uint(8):]), pis)
		intrinsics.unaligned_store((^u64)(state[uint(16):]), psc)
		intrinsics.unaligned_store((^u64)(state[uint(24):]), err)
		return n
	}

	// simdjson stage 1 over nblocks 64-byte blocks: writes the structural positions (idx + offset, as u32) to out and returns how many (out holds 64 * nblocks u32; the entries past the count may be overwritten); state (NVOL_JSON_STATE_BYTES, zero at the start of a document) carries the escape, string and scalar state between calls, and word 3 is non-zero once a control byte was found inside a string.
	nvol_json_index_raw :: #force_inline proc "contextless" (state: [^]u8, blocks: [^]u8, nblocks: uint, idx: uint, out: [^]u8) -> uint { return nvol_json_index_neon(state, blocks, nblocks, idx, out) }

	// test hook: -1 = autodetect, 0 = force the SSE2/SSSE3 paths (no AVX2, no SSE4.2), 1 = force AVX2, 2 = force SSE4.2 without AVX2 (x86 only)
	nvol_test_set_avx2 :: proc "contextless" (v: int) {
		_ = v
	}
}

// ---------------------------------------------------------------- API

memchr :: proc "contextless" (n1: u8, hay: []u8) -> (index: int, ok: bool) {
	r := nvol_memchr(n1, raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

memrchr :: proc "contextless" (n1: u8, hay: []u8) -> (index: int, ok: bool) {
	r := nvol_memrchr(n1, raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

memchr2 :: proc "contextless" (n1: u8, n2: u8, hay: []u8) -> (index: int, ok: bool) {
	r := nvol_memchr2(n1, n2, raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

memrchr2 :: proc "contextless" (n1: u8, n2: u8, hay: []u8) -> (index: int, ok: bool) {
	r := nvol_memrchr2(n1, n2, raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

memchr3 :: proc "contextless" (n1: u8, n2: u8, n3: u8, hay: []u8) -> (index: int, ok: bool) {
	r := nvol_memchr3(n1, n2, n3, raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

memrchr3 :: proc "contextless" (n1: u8, n2: u8, n3: u8, hay: []u8) -> (index: int, ok: bool) {
	r := nvol_memrchr3(n1, n2, n3, raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

count_parity :: proc "contextless" (n1: u8, hay: []u8) -> int {
	return int(nvol_count_parity(n1, raw_data(hay), uint(len(hay))))
}

count :: proc "contextless" (n1: u8, hay: []u8) -> int {
	return int(nvol_count(n1, raw_data(hay), uint(len(hay))))
}

first_non_ascii :: proc "contextless" (hay: []u8) -> (index: int, ok: bool) {
	r := nvol_first_non_ascii(raw_data(hay), uint(len(hay)))
	if r == max(uint) { return -1, false }
	return int(r), true
}

// Iterator over match positions of 1..3 needles; next_back walks from the end.
Memchr_Iter :: struct { base, lo, hi: [^]u8, n1, n2, n3: u8, k: int }

memchr_iter :: proc "contextless" (hay: []u8, needles: ..u8) -> Memchr_Iter {
	p := raw_data(hay)
	it := Memchr_Iter{base = p, lo = p, hi = p[len(hay):], k = len(needles)}
	if len(needles) > 0 { it.n1 = needles[0] }
	if len(needles) > 1 { it.n2 = needles[1] }
	if len(needles) > 2 { it.n3 = needles[2] }
	return it
}

memchr_iter_next :: proc "contextless" (it: ^Memchr_Iter) -> (index: int, ok: bool) {
	r: [^]u8
	switch it.k {
	case 1: r = nvol_memchr_raw(it.n1, it.lo, it.hi)
	case 2: r = nvol_memchr2_raw(it.n1, it.n2, it.lo, it.hi)
	case 3: r = nvol_memchr3_raw(it.n1, it.n2, it.n3, it.lo, it.hi)
	case: return -1, false
	}
	if r == nil { it.lo = it.hi; return -1, false }
	it.lo = r[1:]
	return int(uintptr(r) - uintptr(it.base)), true
}

memchr_iter_next_back :: proc "contextless" (it: ^Memchr_Iter) -> (index: int, ok: bool) {
	r: [^]u8
	switch it.k {
	case 1: r = nvol_memrchr_raw(it.n1, it.lo, it.hi)
	case 2: r = nvol_memrchr2_raw(it.n1, it.n2, it.lo, it.hi)
	case 3: r = nvol_memrchr3_raw(it.n1, it.n2, it.n3, it.lo, it.hi)
	case: return -1, false
	}
	if r == nil { it.hi = it.lo; return -1, false }
	it.hi = r
	return int(uintptr(r) - uintptr(it.base)), true
}

// Positions left (consumes the iterator); one needle uses the SAD count kernel.
memchr_iter_count :: proc "contextless" (it: ^Memchr_Iter) -> int {
	if it.k == 1 { n := nvol_count_raw(it.n1, it.lo, it.hi); it.lo = it.hi; return int(n) }
	n := 0
	for { if _, ok := memchr_iter_next(it); !ok { break }; n += 1 }
	return n
}

BYTESET_CLASS_BYTES :: 112   // nvol_byteset_init out
BYTESET_PAIR_BYTES :: 256   // nvol_byteset_pair_init out
BYTESET_MASK_OUT_BYTES :: 16   // nvol_find_byteset_pair_mask_raw out: u64 mask, u64 span
BYTESET_CHAIN_MAX :: 6   // k-compare kernels _k1.._k<CHAIN_MAX>
BYTESET_RANGE_EXTRA_MAX :: 3   // range kernels _r0.._r<RANGE_EXTRA_MAX>
BYTESET_RANGE :: 80   // u8 in the class: 0, or 1 + e when the range kernel _r<e> applies
BYTESET_SET16_OK :: 85   // u8 in the class: 1 when the member list is usable by pcmpistri (1-16 members, no 0)
BYTESET_SET16 :: 96   // 16 bytes in the class: the members in increasing order, then zeros; the only bytes nvol_find_not_byteset_sse42 reads
BYTESET_PAIR_SEL :: 240   // u64 in the pair state: 0 empty, 1..CHAIN_MAX k-compare kernel _k<sel>, CHAIN_MAX + 1 nibble lookup
BYTESET_PAIR_REACH :: 248   // u64 in the pair state: max(i1, i2)

JSON_STATE_BYTES :: 32   // bytes of the nvol_json_index_raw state

MEMMEM_STATE_WORDS :: 8
// Substring finder (memchr::memmem::Finder). Borrows the needle.
Memmem_Finder :: struct { needle: []u8, state: [MEMMEM_STATE_WORDS]u64 }

memmem_finder :: proc "contextless" (needle: []u8) -> (f: Memmem_Finder) {
	f.needle = needle
	p := raw_data(needle)
	nvol_memmem_init(p, p[len(needle):], ([^]u8)(&f.state))
	return
}

memmem_find :: proc "contextless" (f: ^Memmem_Finder, hay: []u8) -> (index: int, ok: bool) {
	if len(f.needle) == 0 { return 0, true }
	h, n := raw_data(hay), raw_data(f.needle)
	r := nvol_memmem_find_raw(([^]u8)(&f.state), n, n[len(f.needle):], h, h[len(hay):])
	if r == nil { return -1, false }
	return int(uintptr(r) - uintptr(h)), true
}

// One-shot (memchr::memmem::find): Rabin-Karp below 64 bytes, else a Finder.
memmem :: proc "contextless" (hay, needle: []u8) -> (index: int, ok: bool) {
	if len(needle) == 0 { return 0, true }
	if len(hay) < 64 {
		h, n := raw_data(hay), raw_data(needle)
		r := nvol_memmem_rk_oneshot(n, n[len(needle):], h, h[len(hay):])
		if r == nil { return -1, false }
		return int(uintptr(r) - uintptr(h)), true
	}
	f := memmem_finder(needle)
	return memmem_find(&f, hay)
}

TEDDY_STATE_BYTES :: 2448
// Packed multi-literal searcher (aho_corasick::packed::Searcher, LeftmostFirst).
Teddy :: struct { blob: []u64, state: [TEDDY_STATE_BYTES / 8]u64 }
Teddy_Match :: struct { pattern, start, end: int }

// ok = false when Teddy can't be used (same cases as aho-corasick); then nothing is allocated.
teddy_build :: proc (patterns: []string, allocator := context.allocator) -> (t: Teddy, ok: bool) {
	total := 8 + 16 * len(patterns)
	for p in patterns { total += len(p) }
	t.blob = make([]u64, (total + 7) / 8, allocator)
	b := ([^]u8)(raw_data(t.blob))
	intrinsics.unaligned_store((^u64)(b), u64(len(patterns)))
	pos := 8 + 16 * len(patterns)
	for p, i in patterns {
		intrinsics.unaligned_store((^u64)(b[8 + 16 * i:]), u64(pos))
		intrinsics.unaligned_store((^u64)(b[16 + 16 * i:]), u64(len(p)))
		for j in 0..<len(p) { b[pos + j] = p[j] }
		pos += len(p)
	}
	nvol_teddy_init(b, ([^]u8)(&t.state))
	if t.state[0] == 0 { delete(t.blob, allocator); t.blob = nil; return t, false }
	return t, true
}

teddy_destroy :: proc (t: ^Teddy, allocator := context.allocator) { delete(t.blob, allocator); t.blob = nil }

// Leftmost-first match within hay[start:end].
teddy_find_in :: proc "contextless" (t: ^Teddy, hay: []u8, start, end: int) -> (m: Teddy_Match, ok: bool) {
	h := raw_data(hay)
	b := ([^]u8)(raw_data(t.blob))
	r := nvol_teddy_find_raw(([^]u8)(&t.state), b, h[start:], h[end:])
	if r == max(uint) { return {}, false }
	pid := int(r & 0xFF)
	ln := int(intrinsics.unaligned_load((^u64)(b[16 + 16 * pid:])))
	s := start + int(r >> 8)
	return Teddy_Match{pid, s, s + ln}, true
}

teddy_find :: proc "contextless" (t: ^Teddy, hay: []u8) -> (m: Teddy_Match, ok: bool) {
	return teddy_find_in(t, hay, 0, len(hay))
}

