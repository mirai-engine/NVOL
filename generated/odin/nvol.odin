			tail_mask: u64 = (u64(18446744073709551615) << overlap)
			e11: V16 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(max_[i1:])), a), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(max_[i1:])), a1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(max_[i1:])), a2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(max_[i1:])), a3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(max_[i1:])), a4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(max_[i1:])), a5))
