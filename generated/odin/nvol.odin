	// Copy [start, end) to dst up to the first byte in the class built by nvol_byteset_init; returns that byte's address, or end. dst needs room for end - start bytes (whole vectors are stored, so bytes after the copied prefix may change); no overlap.
	nvol_copy_until_byteset_raw :: #force_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 { return nvol_copy_until_byteset_entry_neon(cls, start, end, dst) }

	// Every chunk with pair candidates, in order, to visit->fn(ctx, chunk, mask) (mask as in nvol_find_byteset_pair_mask_raw); returns the chunk where the visitor returned true, or NULL at the end. Inline the _visit kernels to fuse the visitor into their loop.
	nvol_find_byteset_pair_visit_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, visit: ^Visitor) -> [^]u8 { return nvol_find_byteset_pair_visit_entry_neon(st, start, end, visit) }

	// First byte of [start, end) in the class built by nvol_byteset_init, or NULL.
	nvol_find_byteset_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_find_byteset_entry_neon(st, start, end) }

	// First byte of [start, end) outside the class built by nvol_byteset_init, or NULL.
	nvol_find_not_byteset_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_find_not_byteset_entry_neon(st, start, end) }

	// First p in [start, end) with p[i1] in set 1 and p[i2] in set 2 (state from nvol_byteset_pair_init), or NULL.
	nvol_find_byteset_pair_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8) -> [^]u8 { return nvol_find_byteset_pair_entry_neon(st, start, end) }

	// Like nvol_find_byteset_pair_raw, but returns the base of the first chunk with candidates and stores all its candidates to *out: position base + i is a candidate when bit i (x86_64) or bit 4i+3 (aarch64) is set. NULL when there is none.
	nvol_find_byteset_pair_mask_raw :: #force_inline proc "contextless" (st: [^]u8, start: [^]u8, end: [^]u8, out: [^]u8) -> [^]u8 { return nvol_find_byteset_pair_mask_entry_neon(st, start, end, out) }

	// stage 1, neon masks
