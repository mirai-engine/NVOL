	// nvol_copy_until_byteset: neon entry point
	@(private)
	nvol_copy_until_byteset_entry_neon :: #force_no_inline proc "contextless" (cls: [^]u8, start: [^]u8, end: [^]u8, dst: [^]u8) -> [^]u8 #no_bounds_check {
		count: uint = uint(intrinsics.unaligned_load((^u64)(cls[uint(48):])))
		len_: uint = uint(intrinsics.ptr_sub((^u8)(end), (^u8)(start)))
		if (len_ < uint(16)) {
