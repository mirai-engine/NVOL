			e1: V16 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i1:])), a), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i1:])), a1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i1:])), a2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i1:])), a3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i1:])), a4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i1:])), a5))
			e2: V16 = intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_max(intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i2:])), b), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i2:])), b1)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i2:])), b2)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i2:])), b3)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i2:])), b4)), intrinsics.simd_lanes_eq(intrinsics.unaligned_load((^V16)(cur[i2:])), b5))
			hit: u64 = (transmute(u64)cast(U8x8)intrinsics.simd_shr(transmute(U16x8)intrinsics.simd_bit_and(e1, e2), (U16x8)(4)) & 0x8888888888888888)
			if (hit != u64(0)) {
				if visit.visit(visit.ctx, cur, hit) {
