diff --git a/include/reflex/nvol_compat.h b/include/reflex/nvol_compat.h
new file mode 100644
index 0000000..68042ae
--- /dev/null
+++ b/include/reflex/nvol_compat.h
@@ -0,0 +1,59 @@
+// NVOL end-to-end: ugrep's byte search routed to NVOL's generated C++ header
+// (generated/cpp/nvol.hpp, header-only, raw layer in nvol::raw, C++17). The AVX2
+// matcher calls the *_entry_avx2 kernels directly, so they inline into its loops.
+// The memchr wrappers keep std::memchr's signatures; call sites only change name.
+#ifndef REFLEX_NVOL_COMPAT_H
+#define REFLEX_NVOL_COMPAT_H
+
+#include <cstddef>
+#include <cstdint>
+#include <nvol.hpp>
+
+using namespace ::nvol::raw;   // every NVOL name starts with nvol_
+
+namespace reflex {
+namespace nvolc {
+
+inline const char *memchr(const char *s, int c, size_t n)
+{
+  const uint8_t *p = reinterpret_cast<const uint8_t*>(s);
+  return reinterpret_cast<const char*>(nvol_memchr_raw(static_cast<uint8_t>(c), p, p + n));
+}
+
+inline char *memchr(char *s, int c, size_t n)
+{
+  return const_cast<char*>(memchr(static_cast<const char*>(s), c, n));
+}
+
+inline const void *memchr(const void *s, int c, size_t n)
+{
+  return memchr(static_cast<const char*>(s), c, n);
+}
+
+inline void *memchr(void *s, int c, size_t n)
+{
+  return const_cast<char*>(memchr(static_cast<const char*>(s), c, n));
+}
+
+// nvol_find_byteset_pair_mask_raw: candidate i of a chunk is bit i (x86_64) or bit 4i+3 (aarch64)
+#if defined(__aarch64__) || defined(_M_ARM64)
+const unsigned POS_BITS = 4;
+#else
+const unsigned POS_BITS = 1;
+#endif
+
+inline unsigned ctz64(uint64_t x)
+{
+#if defined(_MSC_VER)
+  unsigned long r;
+  _BitScanForward64(&r, x);
+  return static_cast<unsigned>(r);
+#else
+  return static_cast<unsigned>(__builtin_ctzll(x));
+#endif
+}
+
+} // namespace nvolc
+} // namespace reflex
+
+#endif
