 // My homegrown "needle search" method when needle pin=1
+// NVOL end-to-end: the pair search hands every chunk with candidates to nvol_pair_visit, which runs
+// predict_match on them; it stops at the first one predict_match accepts. On a long enough
+// haystack the kernel is picked by the selector nvol_byteset_pair_init stored in the state and
+// inlined here with the visitor, so the two loops become one as in ugrep's own code (k-compare
+// chains for small sets, nibble lookup otherwise); short haystacks go through NVOL's entry, which
+// falls back to SSSE3 or scalar.
+inline NVOL_FORCE_INLINE int Matcher::nvol_pair_visit(void *self, const uint8_t *at, uint64_t m)
+{
+  Matcher *t = static_cast<Matcher*>(self);
+  do
+  {
+    const uint8_t *p = at + reflex::nvolc::ctz64(m) / reflex::nvolc::POS_BITS;
+    size_t k = reinterpret_cast<const char*>(p) - t->buf_;
+    if (REFLEX_UNLIKELY(k + Pattern::Const::PM_M > t->end_) || t->pat_->predict_match(&t->buf_[k]))
+    {
+      t->nvol_k_ = k;
+      return 1;
+    }
+    m &= m - 1;
+  } while (m != 0);
+  return 0;
+}
+
+// NVOL end-to-end: true once predict_match accepts a candidate in [loc, end_) (set_current done)
+inline NVOL_FORCE_INLINE bool Matcher::nvol_pair_scan(size_t loc)
+{
+  const uint8_t *st = nvol_pinset_;
+  const uint8_t *s = reinterpret_cast<const uint8_t*>(buf_ + loc);
+  const uint8_t *e = reinterpret_cast<const uint8_t*>(buf_ + end_);
+  if (s >= e)
+    return false;
+  const nvol_visitor v = { &Matcher::nvol_pair_visit, this };
+  uint64_t sel, reach;
+  NVOL_MEMCPY(&sel, st + NVOL_BYTESET_PAIR_SEL, 8);
+  NVOL_MEMCPY(&reach, st + NVOL_BYTESET_PAIR_REACH, 8);
+  const uint8_t *at;
+  // the switch names the kernels NVOL generates for each selector value
+  static_assert(NVOL_BYTESET_CHAIN_MAX == 6, "NVOL pair kernels: _k1.._k6, then the nibble lookup");
+  if (static_cast<uint64_t>(e - s) >= reach + 32)
+  {
+    switch (sel)
+    {
+      case 0: return false;
+      case 1: at = nvol_find_byteset_pair_visit_avx2_k1(st, s, e, &v); break;
+      case 2: at = nvol_find_byteset_pair_visit_avx2_k2(st, s, e, &v); break;
+      case 3: at = nvol_find_byteset_pair_visit_avx2_k3(st, s, e, &v); break;
+      case 4: at = nvol_find_byteset_pair_visit_avx2_k4(st, s, e, &v); break;
+      case 5: at = nvol_find_byteset_pair_visit_avx2_k5(st, s, e, &v); break;
+      case 6: at = nvol_find_byteset_pair_visit_avx2_k6(st, s, e, &v); break;
+      default: at = nvol_find_byteset_pair_visit_avx2(st, s, e, &v); break;
+    }
+  }
+  else
+  {
+    at = nvol_find_byteset_pair_visit_entry_avx2(st, s, e, &v);
+  }
+  if (at == NULL)
+    return false;
+  set_current(nvol_k_);
+  return true;
+}
