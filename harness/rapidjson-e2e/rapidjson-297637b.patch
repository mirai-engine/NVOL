new file mode 100644
index 0000000..a52161d
--- /dev/null
+++ b/include/rapidjson/nvol_compat.h
@@ -0,0 +1,211 @@
+// NVOL end-to-end: rapidjson's SIMD scans (whitespace skip, unescaped string
+// scan, writer copy) routed to NVOL's byte-set search from the generated C++
+// header (nvol.hpp). Enabled with RAPIDJSON_NVOL instead of RAPIDJSON_SSE2 /
+// RAPIDJSON_SSE42; the CPU is checked once at startup and the AVX2 kernel is
+// used when present.
+//
+// The dispatched searches live in one translation unit of the program, the one
+// that defines RAPIDJSON_NVOL_IMPLEMENTATION before including this header (as
+// simdjson ships simdjson.cpp). Every other unit sees declarations:
+// - the searches are opaque calls either way (the kernels are compiled for
+//   AVX2, the parser is not), and declaring them pure lets the compiler keep the
+//   parser state in registers across the call instead of reloading the stream
+//   and re-checking the parse error after every whitespace skip;
+// - the dispatch code is not part of the parser's unit, so it does not use up
+//   the compiler's inlining budget for that unit (GCC's inline-unit-growth),
+//   which otherwise leaves rapidjson's own small helpers out of line.
+// Built with SSE4.2 enabled (-msse4.2, as RAPIDJSON_SSE42 is), the bounded whitespace
+// skip also inlines NVOL's pcmpistri kernel, the only kernel the parser's unit takes.
+#ifndef RAPIDJSON_NVOL_COMPAT_H_
+#define RAPIDJSON_NVOL_COMPAT_H_
+
+#if defined(__SSE4_2__) && (defined(__x86_64__) || defined(_M_X64))
+#define RAPIDJSON_NVOL_INLINE_SSE42 1
+#include <nvol.hpp>
+#endif
+#include <cstring>
+#include <stddef.h>
+#include <stdint.h>
+
+#if defined(__GNUC__) || defined(__clang__)
+#define RAPIDJSON_NVOL_PURE __attribute__((pure))
+#else
+#define RAPIDJSON_NVOL_PURE
+#endif
+
+namespace rapidjson_nvol {
+
+enum { kClassBytes = 112 };   // NVOL_BYTESET_CLASS_BYTES (checked in the implementation)
+
+// Both search sets have well over 6 distinct bytes. The string stop set is a low range
+// plus two bytes, so NVOL gives it the range kernel (_r2: an unsigned min and two
+// compares); the whitespace complement takes the nibble lookup. (Searching past the 4
+// whitespace bytes with nvol_find_not_byteset, one table lookup per vector, measured the
+// same.)
+struct Sets {
+    uint8_t not_ws[kClassBytes];   // every byte except ' ', '\n', '\r', '\t'
+    uint8_t stop[kClassBytes];     // '"', '\\' and 0x00-0x1F
+    uint8_t ws[kClassBytes];       // ' ', '\n', '\r', '\t' (the pcmpistri member list)
+    bool ready;     // false until the constructor ran (static storage starts zeroed)
+    Sets();
+};
+
+// Built during static initialization. A function-local static (built on first
+// use) costs a guard check per call, 3-11 % of rapidjson's parse time.
+extern const Sets sets;
+
+// First byte of [s, e) in the set, or NULL.
+RAPIDJSON_NVOL_PURE const uint8_t *find_checked(const uint8_t *cls, const uint8_t *s, const uint8_t *e);
+
+// First byte from p on in the set, for null-terminated text: the set holds '\0',
+// so the scan stops at the terminator at the latest.
+RAPIDJSON_NVOL_PURE const char *find_terminated(const uint8_t *cls, const char *p);
+
+// Copy [s, e) to dst up to the first byte of the set; returns that byte, or e. Whole
+// vectors are stored: dst needs room for e - s bytes (the writer reserves 6 per source
+// byte), and bytes after the copied prefix are scratch.
+const uint8_t *copy_until_checked(const uint8_t *cls, const uint8_t *s, const uint8_t *e, uint8_t *dst);
+
+#ifdef RAPIDJSON_NVOL_INLINE_SSE42
+// The whitespace class as nvol_find_not_byteset_sse42 reads it: only the member list at
+// NVOL_BYTESET_SET16 (the members in increasing order, then zeros). Constant-initialized,
+// so the inline skip needs no "classes built" check and the compiler sees a constant, as
+// with RAPIDJSON_SSE42's own list. The implementation checks it against nvol_byteset_init.
+struct WsList {
+    uint8_t head[NVOL_BYTESET_SET16];
+    uint8_t list[16];
+};
+static_assert(sizeof(WsList) == NVOL_BYTESET_SET16 + 16, "member list at the end of the class");
+alignas(16) inline constexpr WsList ws_list = {{}, {'\t', '\n', '\r', ' '}};
+
+// First non-whitespace byte of [p, end), or end; needs p <= end - 16 (written exactly like
+// the kernel's own loop test, so the compiler merges the two). Inline: NVOL's pcmpistri
+// kernel, one instruction per 16 bytes, so the short runs of indented JSON cost no call
+// (RAPIDJSON_SSE42 does the same with its own loop).
+inline const char *skip_ws_sse42(const char *p, const char *end) {
+    const uint8_t *r = ::nvol::raw::nvol_find_not_byteset_sse42(reinterpret_cast<const uint8_t *>(&ws_list),
+        reinterpret_cast<const uint8_t *>(p), reinterpret_cast<const uint8_t *>(end));
+    return r ? reinterpret_cast<const char *>(r) : end;
+}
+#endif
+
+} // namespace rapidjson_nvol
+
+#ifdef RAPIDJSON_NVOL_IMPLEMENTATION
+#include <nvol.hpp>
+
+namespace rapidjson_nvol {
+
+using namespace ::nvol::raw;
+
+static_assert(kClassBytes == NVOL_BYTESET_CLASS_BYTES, "class size changed in nvol.hpp");
+static_assert(NVOL_BYTESET_RANGE_EXTRA_MAX >= 2, "the string stop set needs the range kernel _r2");
+
+// A parse that runs from another static initializer before `sets` is built sees
+// empty classes, which match nothing. Until then the searches run these plain loops
+// (the pointers below start on them: constant initialization, before any constructor).
+// They stop at '\0' at the latest, as the kernels do for null-terminated text.
+__attribute__((cold)) static const uint8_t *find_unbuilt(const uint8_t *cls, const uint8_t *s, const uint8_t *e) {
+    for (; s != e; s++) {
+        bool ws = *s == ' ' || *s == '\n' || *s == '\r' || *s == '\t';
+        bool stop = *s == '"' || *s == '\\' || *s < 0x20;
+        if (cls == sets.stop ? stop : !ws)
+            return s;
+    }
+    return NULL;
+}
+
+__attribute__((cold)) static const uint8_t *copy_until_unbuilt(const uint8_t *cls, const uint8_t *s, const uint8_t *e, uint8_t *dst) {
+    const uint8_t *r = find_unbuilt(cls, s, e);
+    if (r == NULL)
+        r = e;
+    std::memcpy(dst, s, static_cast<size_t>(r - s));
+    return r;
+}
+
+#if defined(__x86_64__) || defined(_M_X64)
+NVOL_TARGET_AVX2 static const uint8_t *find_avx2(const uint8_t *cls, const uint8_t *s, const uint8_t *e) {
+    if (e - s >= 32) {
+        if (cls[NVOL_BYTESET_RANGE] == 1 + 2)       // 1 + e: the range kernel _r2
+            return nvol_find_byteset_avx2_r2(cls, s, e);
+        return nvol_find_byteset_avx2(cls, s, e);
+    }
+    return nvol_find_byteset_entry_avx2(cls, s, e);
+}
+
+NVOL_TARGET_AVX2 static const uint8_t *copy_until_avx2(const uint8_t *cls, const uint8_t *s, const uint8_t *e, uint8_t *dst) {
+    if (e - s >= 32) {
+        if (cls[NVOL_BYTESET_RANGE] == 1 + 2)       // 1 + e: the range kernel _r2
+            return nvol_copy_until_byteset_avx2_r2(cls, s, e, dst);
+        return nvol_copy_until_byteset_avx2(cls, s, e, dst);
+    }
+    return nvol_copy_until_byteset_entry_avx2(cls, s, e, dst);
+}
+#endif
+
+// The search for this CPU, chosen once by the constructor below: each search is one
+// call and one indirect jump, with no CPU or "classes built" check on the way.
+typedef const uint8_t *(*find_fn)(const uint8_t *, const uint8_t *, const uint8_t *);
+typedef const uint8_t *(*copy_fn)(const uint8_t *, const uint8_t *, const uint8_t *, uint8_t *);
+static find_fn find_impl = find_unbuilt;
+static copy_fn copy_impl = copy_until_unbuilt;
+
+Sets::Sets() {
+    uint8_t b[256];
+    size_t n = 0;
+    for (int c = 0; c < 256; c++)
+        if (c != ' ' && c != '\n' && c != '\r' && c != '\t')
+            b[n++] = static_cast<uint8_t>(c);
+    nvol_byteset_init(b, n, not_ws);
+    n = 0;
+    for (int c = 0; c < 0x20; c++)
+        b[n++] = static_cast<uint8_t>(c);
+    b[n++] = '"';
+    b[n++] = '\\';
+    nvol_byteset_init(b, n, stop);
+    static const uint8_t space[4] = {' ', '\n', '\r', '\t'};
+    nvol_byteset_init(space, 4, ws);
+#ifdef RAPIDJSON_NVOL_INLINE_SSE42
+    // the constant list the inline skip uses must be the one NVOL builds
+    if (std::memcmp(ws + NVOL_BYTESET_SET16, ws_list.list, 16) != 0 || !ws[NVOL_BYTESET_SET16_OK])
+        __builtin_trap();
+#endif
+    find_impl = nvol_find_byteset_raw;
+    copy_impl = nvol_copy_until_byteset_raw;
+#if defined(__x86_64__) || defined(_M_X64)
+    if (nvol_cpu_avx2()) {
+        find_impl = find_avx2;
+        copy_impl = copy_until_avx2;
+    }
+#endif
+    ready = true;
+}
+
+const Sets sets;
+
+const uint8_t *find_checked(const uint8_t *cls, const uint8_t *s, const uint8_t *e) {
+    return find_impl(cls, s, e);
+}
+
+// Each call to the kernel is bounded by the end of p's 4 KiB page, so no load
+// crosses into a page the text does not reach.
+const char *find_terminated(const uint8_t *cls, const char *p) {
+    for (;;) {
+        const uint8_t *s = reinterpret_cast<const uint8_t *>(p);
+        const uint8_t *e = reinterpret_cast<const uint8_t *>((reinterpret_cast<uintptr_t>(p) | 4095u) + 1);
+        const uint8_t *r = find_impl(cls, s, e);
+        if (r)
+            return reinterpret_cast<const char *>(r);
+        p = reinterpret_cast<const char *>(e);
+    }
+}
+
+const uint8_t *copy_until_checked(const uint8_t *cls, const uint8_t *s, const uint8_t *e, uint8_t *dst) {
+    return copy_impl(cls, s, e, dst);
+}
+
+} // namespace rapidjson_nvol
+
+#endif // RAPIDJSON_NVOL_IMPLEMENTATION
+
+#endif // RAPIDJSON_NVOL_COMPAT_H_
