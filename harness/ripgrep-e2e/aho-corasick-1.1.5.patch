 const PATTERN_LIMIT: usize = 128;
 
+/// NVOL end-to-end: an NVOL Teddy searcher, built only for the default
+/// packed configuration (leftmost-first, nothing forced, heuristic limits on),
+/// which is what regex-automata and aho-corasick's own prefilter use.
+#[derive(Clone, Debug)]
+struct NvolTeddy {
+    #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+    s: Option<crate::nvol::packed::Searcher>,
+}
+
+impl NvolTeddy {
+    fn none() -> NvolTeddy {
+        NvolTeddy {
+            #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+            s: None,
+        }
+    }
+
+    fn new(_patterns: &Patterns) -> NvolTeddy {
+        #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+        {
+            let pats = (0.._patterns.len()).map(|i| {
+                _patterns.get(crate::util::primitives::PatternID::new_unchecked(i)).bytes().to_vec()
+            });
+            return NvolTeddy { s: crate::nvol::packed::Searcher::new(pats) };
+        }
+        #[allow(unreachable_code)]
+        NvolTeddy::none()
+    }
+
+    /// `Some(result)` when NVOL handled the search.
+    #[inline(always)]
+    fn find(&self, _haystack: &[u8], _span: Span) -> Option<Option<Match>> {
+        #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+        {
+            if let Some(ref s) = self.s {
+                return Some(s.find_in(_haystack, _span.start.._span.end).map(|m| {
+                    Match::new(
+                        crate::util::primitives::PatternID::new_unchecked(m.pattern),
+                        m.start..m.end,
+                    )
+                }));
+            }
+        }
+        None
+    }
+}
