+#[cfg(all(test, feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+#[test]
+fn nvol_backs_default_teddy() {
+    let s = Searcher::new(["Sherlock", "Watson", "Moriarty"]).unwrap();
+    assert!(s.nvol.s.is_some(), "default packed searcher must use NVOL Teddy");
+    let h = b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx Doctor Watson and Sherlock";
+    let m = s.find(&h[..]).unwrap();
+    assert_eq!((m.pattern().as_usize(), m.start()), (1, 48));
+}
