+/// NVOL end-to-end: the precomputed state of an NVOL `memmem` finder. It is
+/// only built for the default configuration (default ranker, prefilter on),
+/// which is what `Finder::new` (and thus regex-automata) uses.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct NvolState {
+    #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+    s: Option<[u64; crate::nvol::memmem::STATE_WORDS]>,
+}
+
+impl NvolState {
+    #[inline]
+    fn none() -> NvolState {
+        NvolState {
+            #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+            s: None,
+        }
+    }
+
+    #[inline]
+    fn new(_needle: &[u8]) -> NvolState {
+        #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+        {
+            let mut st = [0u64; crate::nvol::memmem::STATE_WORDS];
+            unsafe {
+                let p = _needle.as_ptr();
+                crate::nvol::raw::nvol_memmem_init(p, p.add(_needle.len()), st.as_mut_ptr() as *mut u8);
+            }
+            return NvolState { s: Some(st) };
+        }
+        #[allow(unreachable_code)]
+        NvolState::none()
+    }
+
+    /// `Some(result)` when NVOL handled the search.
+    #[inline(always)]
+    fn find(&self, _haystack: &[u8], _needle: &[u8]) -> Option<Option<usize>> {
+        #[cfg(all(feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+        {
+            if let Some(ref st) = self.s {
+                if _haystack.len() < _needle.len() {
+                    return Some(None);
+                }
+                return Some(unsafe {
+                    let (h, n) = (_haystack.as_ptr(), _needle.as_ptr());
+                    let p = crate::nvol::raw::nvol_memmem_find_raw(
+                        st.as_ptr() as *const u8, n, n.add(_needle.len()), h, h.add(_haystack.len()));
+                    if p.is_null() { None } else { Some(p as usize - h as usize) }
+                });
+            }
+        }
+        None
+    }
+}
