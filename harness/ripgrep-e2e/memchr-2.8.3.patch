+#[cfg(all(test, feature = "std", any(target_arch = "x86_64", target_arch = "aarch64")))]
+#[test]
+fn nvol_backs_default_finder() {
+    let f = Finder::new("Moriarty");
+    assert!(f.nvol.s.is_some(), "Finder::new must use NVOL memmem");
+    assert!(FinderBuilder::new().prefilter(Prefilter::None).build_forward("x").nvol.s.is_none());
+    let h = b"................................................ Professor Moriarty";
+    assert_eq!(f.find(&h[..]), Some(59));
